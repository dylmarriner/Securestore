# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32

DATABASE_URL=postgres://securestore:securestore@localhost:5432/securestore
HOST=0.0.0.0
PORT=8443

# Envelope-encryption master key (local KeyProvider). Swap KMS_PROVIDER for
# aws-kms/gcp-kms/vault-transit in production and implement the KeyProvider
# interface in src/crypto/kms.ts against that KMS/HSM instead of using this.
KMS_PROVIDER=local
SECURESTORE_MASTER_KEY=

# Server-side keys — never derived from or comparable to secret plaintext directly.
SECURESTORE_FINGERPRINT_PEPPER=
SECURESTORE_APIKEY_PEPPER=

# One-time token that unlocks POST /v1/bootstrap to create the first admin
# agent in a fresh deployment. Unset/rotate after initial setup.
SECURESTORE_ADMIN_BOOTSTRAP_TOKEN=

# Optional Unix domain socket (Linux/macOS, e.g. /var/run/securestore.sock)
# or Windows named pipe (e.g. \\.\pipe\securestore) for local clients.
SECURESTORE_SOCKET_PATH=

# Optional: set to switch rate limiting and proxy/temporary-issue sessions
# from per-process memory to Redis, for exact behavior across a
# horizontally scaled deployment (redis://host:6379).
REDIS_URL=

# Optional: OIDC bearer-token auth. An agent registered with
# auth_method=oidc and auth_identifier=<expected sub claim> can then
# authenticate with `Authorization: Bearer <JWT from this issuer>` instead
# of a SecureStore API key.
SECURESTORE_OIDC_ISSUER=
SECURESTORE_OIDC_JWKS_URI=
SECURESTORE_OIDC_AUDIENCE=

# Optional: mTLS auth. Setting all three switches the HTTP listener to
# HTTPS with client-certificate support. An agent registered with
# auth_method=mtls and auth_identifier=<client cert SHA-256 fingerprint>
# then authenticates purely via the TLS handshake, no bearer token needed.
# Set SECURESTORE_MTLS_REQUIRE=1 to reject any TLS connection that doesn't
# present a certificate signed by SECURESTORE_TLS_CA_PATH (otherwise a
# client without a certificate can still connect and fall back to
# API-key/OIDC auth over the same HTTPS listener).
SECURESTORE_TLS_CERT_PATH=
SECURESTORE_TLS_KEY_PATH=
SECURESTORE_TLS_CA_PATH=
SECURESTORE_MTLS_REQUIRE=
